#!/bin/bash

echo "Installing fastembed..."
pip install --no-cache-dir fastembed

echo "Pre-downloading and caching the embedding model for offline/runtime use..."
python3 -c '
from fastembed import TextEmbedding
model = TextEmbedding(model_name="BAAI/bge-small-en-v1.5", cache_dir="data/fastembed_cache/")
print("Fastembed model cached successfully!")
'